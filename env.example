# ====================================================
# NGUON THE THAO VIP - Environment Variables Template
# ====================================================
# Copy file này thành .env.local và điền thông tin

# --- App ---
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# --- Dùng bởi scripts/generate-playlists.js (GitHub Actions tự sinh file
# .m3u tĩnh) — workflow .github/workflows/validate-and-generate.yml giờ TỰ
# DÒ domain đang deploy qua GitHub Deployments API (Vercel tự tạo), không
# cần khai báo gì. Biến này chỉ dùng khi chạy script trên máy local, hoặc
# làm phương án dự phòng nếu 1 lúc nào đó GitHub Actions không dò được.
# SITE_URL=https://nguonvip.vercel.app

# --- Service Domains (tùy chỉnh khi domain nguồn đổi — các site này bị chặn
# nên đổi domain khá thường xuyên; set các biến này trên Vercel > Settings >
# Environment Variables rồi redeploy, KHÔNG cần sửa code) ---
# PHAOHOA_DOMAIN=https://phaohoa1.live
# GIOVANG_DOMAIN=https://giovang.city
# GIOVANG_LIVE_API_HOST=https://live-api.keonhacaitp.one
