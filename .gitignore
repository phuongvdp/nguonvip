# ===== PLAYLISTS (Generated) =====
# public/playlists/*.m3u — CỐ Ý KHÔNG ignore nữa: workflow
# .github/workflows/validate-and-generate.yml (scripts/generate-playlists.js)
# sinh các file .m3u này để COMMIT vào repo làm bản backup tĩnh, nên phải
# được Git theo dõi. .refresh-state.json cũng cần được track để nhớ chu kỳ
# tự giãn/thu giữa các lần chạy CI.
public/playlists/stats.json
public/playlists/manifest.json

